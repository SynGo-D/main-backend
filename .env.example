NODE_ENV=development
PORT=4000

# Where our Next.js frontend runs.
FRONTEND_ORIGIN=http://localhost:3000

# Public URL of THIS backend. In dev this can be http://localhost:4000
# because GitHub/GitLab redirects the browser here — the browser is on the
# same machine.
PUBLIC_BASE_URL=http://localhost:4000

# Internal DNS name of the integration service inside docker-compose.
INTEGRATION_SERVICE_URL=http://integration-service:4001

# MUST match INTERNAL_API_KEY in the integration service.
INTERNAL_API_KEY=REPLACE_ME_WITH_A_SHARED_SECRET

# HMAC secret for signing session cookies (>= 32 chars).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
